diff --git a/src/auth/session.py b/src/auth/session.py
index 2345678..bcdefgh 100644
--- a/src/auth/session.py
+++ b/src/auth/session.py
@@ -42,8 +42,14 @@ def create_session(user_id: str) -> Session:
-    session = Session(user_id=user_id)
-    return session
+    session = Session(user_id=user_id, created_at=datetime.utcnow())
+    session.refresh_token = generate_refresh_token()
+    return session
+
+def refresh_token(token: str) -> Session:
+    """Refresh an expired session token."""
+    payload = decode_jwt(token)
+    return create_session(payload["user_id"])

